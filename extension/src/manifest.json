{
  "manifest_version": 3,
  "name": "LockedIn",
  "description": "Blocks distracting sites during focus sessions and shows a floating timer.",
  "version": "0.1.0",
  "action": {
    "default_popup": "popup.html",
    "default_title": "LockedIn"
  },
  "background": {
    "service_worker": "service-worker.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content-script.js"],
      "run_at": "document_idle"
    }
  ]
}
