# Copy this file to .env for local runs, and add the same names in
# Vercel > Project > Settings > Environment Variables (Production and Preview).

# The dashboard password you type on the login screen. Pick your own, 12+ characters.
APP_PASSWORD=

# Signs the login cookie. Generate 64 hex characters with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Supabase project URL, from Supabase > Project Settings > API
SUPABASE_URL=

# Server-side Supabase key, from Supabase > Project Settings > API keys > service_role.
# Long string. Keep it secret; never use it in browser code.
SUPABASE_SERVICE_ROLE_KEY=

# Sends the end of day report, from resend.com > API Keys > Create. Starts with re_.
RESEND_API_KEY=

# Where the EOD report goes. This MUST be the email address you signed up to Resend with.
REPORT_TO_EMAIL=

# Sender address shown on the EOD email. Fixed value from the spec.
REPORT_FROM_EMAIL=LockedIn <onboarding@resend.dev>

# Protects the daily keepalive cron. Generate 64 hex characters with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=

# AI helper mode (used from ticket T8). Starts with sk-ant-. Leave empty until then.
ANTHROPIC_API_KEY=
